{
  "name": "django-nplus1-hunter",
  "displayName": "Django N+1 Hunter",
  "description": "Highlights N+1 queries detected by django-nplus1-hunter directly in your code.",
  "version": "1.2.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/.nplus1-hunter.jsonl"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Django N+1 Hunter",
      "properties": {
        "djangoNPlus1Hunter.logFile": {
          "type": "string",
          "default": ".nplus1-hunter.jsonl",
          "description": "Path to the JSONL log file generated by the Django middleware."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "^18.x",
    "typescript": "^5.1.3"
  }
}
